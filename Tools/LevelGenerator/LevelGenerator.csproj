<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generador de niveles de Crystal Clash (herramienta, fuera de Assets).
    Diseña los niveles y los calibra simulando partidas con la misma lógica del juego.
    Uso (desde la raíz del repo, requiere .NET 8):
      dotnet run -c Release (project Tools/LevelGenerator)
    Escribe Assets/Resources/Levels/levels.json
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Board\Logic\*.cs" Link="Shared\Board\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Scripts\Story\Logic\*.cs" Link="Shared\Story\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
